---
/**
 * Custom Keystatic shell — replaces the stock blank client:only page so users
 * see a paper-styled loading state instead of a multi-second white screen while
 * the ~2.8MB Admin bundle downloads and hydrates.
 */
export const prerender = false

// Same entry the integration uses (makePage(config) React root).
import { Keystatic } from '../../../node_modules/@keystatic/astro/internal/keystatic-page.js'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Admin · P.</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #fefefb;
        color: #24231f;
        font-family:
          system-ui,
          -apple-system,
          'PingFang SC',
          'Microsoft YaHei',
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          'Noto Sans SC',
          sans-serif;
      }
      html.dark,
      html.dark body {
        background: #1c1c1e;
        color: #e5e5ea;
      }
      #priority-ks-boot {
        position: fixed;
        inset: 0;
        z-index: 2147483646;
        display: grid;
        place-items: center;
        align-content: center;
        gap: 0.85rem;
        background: inherit;
        transition: opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      }
      #priority-ks-boot[data-hide='1'] {
        opacity: 0;
        pointer-events: none;
      }
      #priority-ks-boot .mark {
        font-family: 'Great Vibes', cursive, serif;
        font-size: 2rem;
        color: #c56473;
        line-height: 1;
      }
      #priority-ks-boot .dot {
        width: 1.35rem;
        height: 1.35rem;
        border: 2px solid #d0cec6;
        border-top-color: #c56473;
        border-radius: 50%;
        animation: priority-ks-spin 0.75s linear infinite;
      }
      html.dark #priority-ks-boot .dot {
        border-color: #3a3a3c;
        border-top-color: #d67a88;
      }
      #priority-ks-boot p {
        margin: 0;
        font-size: 0.8125rem;
        color: #787670;
        letter-spacing: 0.02em;
      }
      html.dark #priority-ks-boot p {
        color: #8e8e93;
      }
      @keyframes priority-ks-spin {
        to {
          transform: rotate(360deg);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #priority-ks-boot .dot {
          animation: none;
          border-top-color: #c56473;
        }
      }
    </style>
    <script is:inline>
      ;(function () {
        try {
          var key = 'darkModel'
          var stored = localStorage.getItem(key)
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
          var theme = stored || (prefersDark ? 'dark' : 'light')
          if (theme === 'dark') document.documentElement.classList.add('dark')
        } catch (_) {}
      })()
    </script>
  </head>
  <body>
    <div id="priority-ks-boot" aria-live="polite" aria-busy="true">
      <div class="mark" aria-hidden="true">P.</div>
      <div class="dot" aria-hidden="true"></div>
      <p>正在加载编辑后台…</p>
    </div>

    <Keystatic client:only="react" />

    <script is:inline>
      ;(function () {
        var boot = document.getElementById('priority-ks-boot')
        if (!boot) return

        function ready() {
          // Keystatic scheme root, login CTA, or collection chrome
          if (
            document.querySelector(
              '.kui-scheme--light, .kui-scheme--dark, .kui-scheme--auto',
            )
          )
            return true
          var t = document.body ? document.body.innerText || '' : ''
          if (/Log in with GitHub|使用 GitHub|Collections|Dashboard|Blogs|Leetcode/i.test(t))
            return true
          // Any substantial UI besides our boot
          if (document.querySelector('button, [role="navigation"], main')) return true
          return false
        }

        function hide() {
          boot.setAttribute('data-hide', '1')
          boot.setAttribute('aria-busy', 'false')
          setTimeout(function () {
            if (boot && boot.parentNode) boot.parentNode.removeChild(boot)
          }, 320)
        }

        var n = 0
        var id = setInterval(function () {
          n++
          if (ready()) {
            clearInterval(id)
            hide()
          } else if (n > 100) {
            // ~10s: still show something rather than infinite spinner
            clearInterval(id)
            boot.querySelector('p').textContent =
              '加载较慢，请检查网络或刷新。若持续空白，打开控制台查看报错。'
          }
        }, 100)
      })()
    </script>
  </body>
</html>
